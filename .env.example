# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gallery
DB_PASSWORD=123456
DB_NAME=gallery
DB_DATABASE=gallery
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# Authentication
# Use a cryptographically secure value with at least 32 characters.
JWT_SECRET=replace-with-a-secure-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

# Admin seed account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-local-password

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=gallery
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paymob payment gateway
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Gmail SMTP (Google App Password, not your normal password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Future integrations (added when their modules are implemented)
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=
